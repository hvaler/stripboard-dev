{
  "uid": "stripboard-agents",
  "title": "The Agents Themselves — Stripboard",
  "description": "The other half of the Grafana track: observe the agent you build (EV-47).\n\nSeparate from 'Shoot Mission Control' on purpose. That dashboard answers 'how is the production doing'; this one answers 'how is the software doing', and putting the two on one screen makes neither question easy to ask.\n\nEvery panel is scoped to the selected time range rather than to the last few minutes. These agents work in bursts — a producer asks three questions and then nothing for hours — so an instant query reports 'No data' a quarter of an hour after a demo that went perfectly. Widen the range to find the activity.",
  "tags": [
    "stripboard",
    "agents",
    "ai-observability"
  ],
  "timezone": "browser",
  "schemaVersion": 39,
  "refresh": "30s",
  "time": {
    "from": "now-24h",
    "to": "now"
  },
  "templating": {
    "list": []
  },
  "annotations": {
    "list": []
  },
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "🎟️ Tokens spent",
      "description": "Every Gemini token consumed in this range. 'Ask your shoot' runs several rounds per question, so one question can cost ten thousand.",
      "datasource": {
        "type": "prometheus",
        "uid": "grafanacloud-prom"
      },
      "gridPos": {
        "h": 4,
        "w": 6,
        "x": 0,
        "y": 0
      },
      "fieldConfig": {
        "defaults": {
          "noValue": "no agent activity in this range",
          "color": {
            "mode": "fixed",
            "fixedColor": "text"
          },
          "unit": "short"
        },
        "overrides": []
      },
      "options": {
        "colorMode": "none",
        "graphMode": "none",
        "textMode": "value",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(max_over_time(agent_llm_tokens_total[$__range]))",
          "instant": true
        }
      ]
    },
    {
      "id": 2,
      "type": "stat",
      "title": "🔌 MCP calls",
      "description": "Every tools/call made to Grafana and to our own servers. The partner integration counted from the inside.",
      "datasource": {
        "type": "prometheus",
        "uid": "grafanacloud-prom"
      },
      "gridPos": {
        "h": 4,
        "w": 6,
        "x": 6,
        "y": 0
      },
      "fieldConfig": {
        "defaults": {
          "noValue": "no agent activity in this range",
          "color": {
            "mode": "fixed",
            "fixedColor": "text"
          },
          "unit": "short"
        },
        "overrides": []
      },
      "options": {
        "colorMode": "none",
        "graphMode": "none",
        "textMode": "value",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(max_over_time(agent_mcp_calls_total[$__range]))",
          "instant": true
        }
      ]
    },
    {
      "id": 3,
      "type": "stat",
      "title": "❌ MCP calls that failed",
      "description": "Counted separately, and red only when there is something to be red about. A counter that increments solely on success reports a healthy integration right up until nothing works.",
      "datasource": {
        "type": "prometheus",
        "uid": "grafanacloud-prom"
      },
      "gridPos": {
        "h": 4,
        "w": 6,
        "x": 12,
        "y": 0
      },
      "fieldConfig": {
        "defaults": {
          "noValue": "no agent activity in this range",
          "color": {
            "mode": "thresholds"
          },
          "unit": "short",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "text",
                "value": null
              },
              {
                "color": "red",
                "value": 1
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "colorMode": "value",
        "graphMode": "none",
        "textMode": "value",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(max_over_time(agent_mcp_calls_total{status=\"error\"}[$__range]))",
          "instant": true
        }
      ]
    },
    {
      "id": 4,
      "type": "stat",
      "title": "💬 Questions answered",
      "description": "Completed Gemini exchanges. Divide the tokens by this and you have what a question costs.",
      "datasource": {
        "type": "prometheus",
        "uid": "grafanacloud-prom"
      },
      "gridPos": {
        "h": 4,
        "w": 6,
        "x": 18,
        "y": 0
      },
      "fieldConfig": {
        "defaults": {
          "noValue": "no agent activity in this range",
          "color": {
            "mode": "fixed",
            "fixedColor": "text"
          },
          "unit": "short"
        },
        "overrides": []
      },
      "options": {
        "colorMode": "none",
        "graphMode": "none",
        "textMode": "value",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(max_over_time(agent_llm_duration_milliseconds_count[$__range]))",
          "instant": true
        }
      ]
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "💬 When the questions happened",
      "description": "Tokens per five minutes. Spikes are questions; the flat stretches are a producer not asking anything, which is the normal state of this system.",
      "datasource": {
        "type": "prometheus",
        "uid": "grafanacloud-prom"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 4
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "noValue": "no agent activity in this range",
          "custom": {
            "fillOpacity": 20,
            "showPoints": "auto"
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (model) (increase(agent_llm_tokens_total[5m]))",
          "legendFormat": "{{model}}"
        }
      ]
    },
    {
      "id": 6,
      "type": "bargauge",
      "title": "🔧 Which MCP tools, how often",
      "description": "Not 'we use MCP' but which tools the agents actually reach for. The shape of this is the integration's real surface area.",
      "datasource": {
        "type": "prometheus",
        "uid": "grafanacloud-prom"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 4
      },
      "fieldConfig": {
        "defaults": {
          "noValue": "no agent activity in this range",
          "color": {
            "mode": "fixed",
            "fixedColor": "text"
          },
          "unit": "short"
        },
        "overrides": []
      },
      "options": {
        "displayMode": "gradient",
        "orientation": "horizontal",
        "showUnfilled": true,
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        }
      },
      "targets": [
        {
          "refId": "A",
          "instant": true,
          "expr": "sum by (tool) (max_over_time(agent_mcp_calls_total[$__range]))",
          "legendFormat": "{{tool}}"
        }
      ]
    },
    {
      "id": 7,
      "type": "bargauge",
      "title": "⏱️ Where the twenty seconds go",
      "description": "p95 of model time against p95 of tool time, over the selected range. 'The model is slow' and 'Grafana is slow' need different fixes, and one number cannot tell them apart. Buckets read with max_over_time rather than increase: these agents answer a handful of questions a day, and increase() needs two samples in the window to return anything at all — so it reports NaN for exactly the sparse traffic this dashboard exists to show.",
      "datasource": {
        "type": "prometheus",
        "uid": "grafanacloud-prom"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 12
      },
      "fieldConfig": {
        "defaults": {
          "noValue": "no agent activity in this range",
          "color": {
            "mode": "fixed",
            "fixedColor": "text"
          },
          "unit": "ms"
        },
        "overrides": []
      },
      "options": {
        "displayMode": "gradient",
        "orientation": "horizontal",
        "showUnfilled": true,
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        }
      },
      "targets": [
        {
          "refId": "A",
          "instant": true,
          "expr": "histogram_quantile(0.95, sum by (le) (max_over_time(agent_llm_duration_milliseconds_bucket[$__range])))",
          "legendFormat": "Gemini — thinking"
        },
        {
          "refId": "B",
          "instant": true,
          "expr": "histogram_quantile(0.95, sum by (le, server) (max_over_time(agent_mcp_duration_milliseconds_bucket[$__range])))",
          "legendFormat": "{{server}} — answering"
        }
      ]
    },
    {
      "id": 8,
      "type": "bargauge",
      "title": "📊 Calls by outcome",
      "description": "ok against error. A bar appearing on the error side is the first thing that would tell you the sentinel has stopped being able to read its alerts.",
      "datasource": {
        "type": "prometheus",
        "uid": "grafanacloud-prom"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 12
      },
      "fieldConfig": {
        "defaults": {
          "noValue": "no agent activity in this range",
          "color": {
            "mode": "fixed",
            "fixedColor": "text"
          },
          "unit": "short"
        },
        "overrides": []
      },
      "options": {
        "displayMode": "gradient",
        "orientation": "horizontal",
        "showUnfilled": true,
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        }
      },
      "targets": [
        {
          "refId": "A",
          "instant": true,
          "expr": "sum by (status) (max_over_time(agent_mcp_calls_total[$__range]))",
          "legendFormat": "{{status}}"
        }
      ]
    }
  ]
}
