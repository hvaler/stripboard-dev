@page "/proposals"
@using Microsoft.EntityFrameworkCore
@using Stripboard.Infrastructure.Persistence
@using Stripboard.Domain.Entities
@inject StripboardDbContext DbContext

<PageTitle>Proposals & Approval — Stripboard</PageTitle>

<h1 class="mb-4">⚖️ Re-planning Proposals & Governance</h1>

<p class="text-muted">
    Review alternative schedule proposals generated by the Replanner Agent upon disruption.
    <strong>The LLM formulates, the solver decides, a human approves.</strong>
</p>

@if (isApproved)
{
    <div class="alert alert-success alert-dismissible fade show" role="alert">
        <strong>✅ Proposal Approved!</strong> Schedule version committed by Producer. Previous versions marked as superseded.
    </div>
}

<div class="row g-4 mt-2">
    <!-- Option A -->
    <div class="col-md-6">
        <div class="card h-100 border-primary shadow-sm">
            <div class="card-header bg-primary text-white d-flex justify-content-between align-items-center">
                <h5 class="mb-0">Option A: Interior Cover Swap</h5>
                <span class="badge bg-light text-primary fw-bold">Draft v2.1</span>
            </div>
            <div class="card-body">
                <p class="card-text text-secondary">
                    Resolved disruption by swapping scheduled outdoor scenes with indoor cover scenes.
                    Maintains target completion date with zero extra shooting days.
                </p>
                <hr />
                <h6>📊 Cost & Impact Deltas:</h6>
                <ul class="list-group list-group-flush mb-3">
                    <li class="list-group-item d-flex justify-content-between">
                        <span>Extra Shooting Days:</span>
                        <strong class="text-success">0 days</strong>
                    </li>
                    <li class="list-group-item d-flex justify-content-between">
                        <span>Extra Hold Days:</span>
                        <strong>1 day</strong>
                    </li>
                    <li class="list-group-item d-flex justify-content-between">
                        <span>Company Moves:</span>
                        <strong>0 moves</strong>
                    </li>
                    <li class="list-group-item d-flex justify-content-between">
                        <span>Estimated Cost Delta:</span>
                        <strong class="text-success">+$1,500.00 USD</strong>
                    </li>
                </ul>
            </div>
            <div class="card-footer bg-white border-top-0 pb-3">
                <button class="btn btn-primary w-100 fw-bold" @onclick="ApproveOptionA" disabled="@isApproved">
                    ✓ Approve Option A (Producer)
                </button>
            </div>
        </div>
    </div>

    <!-- Option B -->
    <div class="col-md-6">
        <div class="card h-100 border-secondary shadow-sm">
            <div class="card-header bg-dark text-white d-flex justify-content-between align-items-center">
                <h5 class="mb-0">Option B: Standby Rest Day</h5>
                <span class="badge bg-secondary">Draft v2.2</span>
            </div>
            <div class="card-body">
                <p class="card-text text-secondary">
                    Inserts a 1-day standby period for cast recovery and permit renewal.
                    Minimizes daily crunch time but adds 1 shooting day and crew overtime.
                </p>
                <hr />
                <h6>📊 Cost & Impact Deltas:</h6>
                <ul class="list-group list-group-flush mb-3">
                    <li class="list-group-item d-flex justify-content-between">
                        <span>Extra Shooting Days:</span>
                        <strong class="text-danger">+1 day</strong>
                    </li>
                    <li class="list-group-item d-flex justify-content-between">
                        <span>Extra Hold Days:</span>
                        <strong>2 days</strong>
                    </li>
                    <li class="list-group-item d-flex justify-content-between">
                        <span>Company Moves:</span>
                        <strong>1 move</strong>
                    </li>
                    <li class="list-group-item d-flex justify-content-between">
                        <span>Estimated Cost Delta:</span>
                        <strong class="text-danger">+$8,500.00 USD</strong>
                    </li>
                </ul>
            </div>
            <div class="card-footer bg-white border-top-0 pb-3">
                <button class="btn btn-outline-secondary w-100 fw-bold" @onclick="ApproveOptionB" disabled="@isApproved">
                    ✓ Approve Option B (Producer)
                </button>
            </div>
        </div>
    </div>
</div>

@code {
    private bool isApproved = false;

    private async Task ApproveOptionA()
    {
        isApproved = true;
        var audit = new AuditEvent(
            Guid.NewGuid(),
            DateTime.UtcNow,
            "ScheduleCommitted",
            "Producer (Hugo Valer)",
            "Approved Option A (Interior Cover Swap). Version v2.1 committed.",
            Guid.NewGuid()
        );
        DbContext.AuditEvents.Add(audit);
        await DbContext.SaveChangesAsync();
    }

    private async Task ApproveOptionB()
    {
        isApproved = true;
        var audit = new AuditEvent(
            Guid.NewGuid(),
            DateTime.UtcNow,
            "ScheduleCommitted",
            "Producer (Hugo Valer)",
            "Approved Option B (Standby Rest Day). Version v2.2 committed.",
            Guid.NewGuid()
        );
        DbContext.AuditEvents.Add(audit);
        await DbContext.SaveChangesAsync();
    }
}
