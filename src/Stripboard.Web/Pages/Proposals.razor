@page "/proposals"
@using Stripboard.Application.Common.Models
@using Stripboard.Application.Services
@using Stripboard.Domain.Entities
@using Stripboard.Infrastructure.Services
@inject ReplanService Replanner
@inject ScheduleService Schedules

<PageTitle>Proposals &amp; Approval — Stripboard</PageTitle>

<h1 class="mb-3">Re-planning proposals</h1>

<p class="text-muted">
    Each option is a separate CP-SAT run under different constraints. The deltas below are the
    difference between two solved schedules — not estimates.
    <strong>The LLM formulates, the solver decides, a human approves.</strong>
</p>

@if (isLoading)
{
    <Busy Label="Loading the replan options" Rows="4" />
}
else if (loadError is not null)
{
    <div class="alert alert-danger">
        <h5 class="alert-heading fw-bold">Could not load proposals</h5>
        <p class="mb-2">@loadError</p>
        <button class="btn btn-outline-danger btn-sm" @onclick="LoadAsync">Retry</button>
    </div>
}
else if (options.Count == 0)
{
    <div class="alert alert-info">
        <h5 class="alert-heading fw-bold">Nothing to decide</h5>
        <p class="mb-0">
            No disruption has been raised yet, so there are no alternative schedules to compare.
            <a href="inject-disruption">Inject a disruption</a> to generate options, or ask
            below what tightening the schedule would cost.
        </p>
    </div>
    @ConsolidatePanel
}
else
{
    @if (disruption is not null && !isConsolidation)
    {
        <div class="alert alert-warning">
            <strong>Disruption:</strong> @disruption.Description
            <div class="small text-muted mt-1">
                @disruption.TriggerType · raised @disruption.Timestamp.ToString("yyyy-MM-dd HH:mm") UTC
                · expected duration @disruption.ExpectedDurationDays day(s)
            </div>
        </div>
    }
    else if (isConsolidation)
    {
        <div class="alert alert-secondary">
            <strong>No disruption — this is a trade, not a recovery.</strong>
            <div class="small mt-1">
                Nothing is blocked. These options price what capping the shooting day at
                @consolidateCap location(s) would cost.
            </div>
        </div>
    }

    <div class="d-flex align-items-center gap-3 mb-3 p-3 border rounded bg-light">
        <label class="fw-semibold mb-0">Acting as:</label>
        <select class="form-select w-auto" @bind="identity" disabled="@isCommitting">
            <option value="@AgentAuthorizationService.RoleProducer">Producer (human)</option>
            <option value="@AgentAuthorizationService.SaReplanner">sa-replanner (agent)</option>
            <option value="@AgentAuthorizationService.SaSentinel">sa-sentinel (agent)</option>
        </select>
        <span class="text-muted small">
            Only the Producer may commit a schedule. Agents can propose; they cannot decide.
        </span>
    </div>

    @if (commitMessage is not null)
    {
        <div class="alert alert-success">@commitMessage</div>
    }
    @if (commitError is not null)
    {
        <div class="alert alert-danger">
            <strong>Refused:</strong> @commitError
        </div>
    }

    <div class="row g-4 mt-1">
        @foreach (var option in options)
        {
            <div class="col-md-6">
                <div class="card h-100 shadow-sm @(option.IsFeasible ? "border-primary" : "border-danger")">
                    <div class="card-header @(option.IsFeasible ? "bg-primary" : "bg-danger") text-white d-flex justify-content-between align-items-center">
                        <h5 class="mb-0">@option.Title</h5>
                        <span class="badge bg-light text-dark fw-bold">@option.Strategy</span>
                    </div>
                    <div class="card-body">
                        <p class="card-text text-secondary">@option.Justification</p>

                        @if (option.IsCommitted)
                        {
                            @* Approving what is already in force is not a decision, and offering
                               it as one made an approval that worked look like a button that
                               did not. *@
                            <div class="alert alert-success py-2 small mb-3">
                                <strong>This is the committed schedule.</strong>
                                It is what the production is working to right now, so there is
                                nothing here to approve.
                            </div>
                        }

                        @if (option.SameFiguresAs is { } twin)
                        {
                            <div class="alert alert-secondary py-2 small mb-3">
                                Same outcome as <strong>@twin</strong> on every figure below —
                                this is not a second choice.
                            </div>
                        }

                        @if (option.IsFeasible)
                        {
                            <hr />
                            <h6 class="label mb-2">Cost and impact deltas</h6>
                            <ul class="list-group list-group-flush mb-3">
                                <li class="list-group-item d-flex justify-content-between">
                                    <span>Shoot days</span>
                                    <strong>@option.Metrics.TotalDays (@Signed(option.Delta.ExtraShootDays))</strong>
                                </li>
                                <li class="list-group-item d-flex justify-content-between">
                                    <span>Company moves</span>
                                    <strong>@option.Metrics.CompanyMoves (@Signed(option.Delta.ExtraCompanyMoves))</strong>
                                </li>
                                <li class="list-group-item d-flex justify-content-between">
                                    <span>Union violations</span>
                                    <strong class="@(option.Metrics.UnionViolations == 0 ? "text-success" : "text-danger")">
                                        @option.Metrics.UnionViolations (@Signed(option.Delta.ExtraUnionViolations))
                                    </strong>
                                </li>
                                <li class="list-group-item d-flex justify-content-between">
                                    <span>Estimated cost delta</span>
                                    <strong class="@(option.Delta.CostDeltaUsd <= 0 ? "text-success" : "text-danger")">
                                        @(option.Delta.CostDeltaUsd >= 0 ? "+" : "")@option.Delta.CostDeltaUsd.ToString("C0", Culture)
                                    </strong>
                                </li>
                            </ul>
                        }
                    </div>
                    <div class="card-footer bg-white border-top-0 pb-3">
                        @if (option.IsCommitted)
                        {
                            <div class="text-center text-success fw-bold py-2">In force</div>
                        }
                        else
                        {
                            <button class="btn btn-primary w-100 fw-bold"
                                    @onclick="() => CommitAsync(option)"
                                    disabled="@(isCommitting || !option.IsFeasible)">
                                Approve @option.Title
                            </button>
                        }
                    </div>
                </div>
            </div>
        }
    </div>

    @ConsolidatePanel
}

@* A Grafana alert about the schedule's quality blocks no scene, so there is no disruption to
   absorb — only a constraint to price. This is that path, on screen. *@
@code {
    private RenderFragment ConsolidatePanel => @<div class="card mt-4 border-secondary">
        <div class="card-header bg-secondary text-white fw-bold">
            Too many locations in a day?
        </div>
        <div class="card-body">
            <p class="text-secondary mb-3">
                Nothing has to have gone wrong for a schedule to be poor. Cap the shooting day
                and the solver will re-solve under that constraint — the extra days it needs
                are what obeying it costs.
            </p>
            <div class="d-flex align-items-center gap-3">
                <label class="fw-semibold mb-0">At most</label>
                <input type="number" class="form-control w-auto" min="1" max="10"
                       @bind="consolidateCap" disabled="@isConsolidating" />
                <span>location(s) per day</span>
                <button class="btn btn-outline-secondary fw-bold"
                        @onclick="ConsolidateAsync" disabled="@isConsolidating">
                    @(isConsolidating ? "Solving…" : "Price it")
                </button>
            </div>
            @if (consolidateError is not null)
            {
                <div class="alert alert-warning mt-3 mb-0">@consolidateError</div>
            }
        </div>
    </div>;

    private static readonly System.Globalization.CultureInfo Culture = System.Globalization.CultureInfo.GetCultureInfo("en-US");

    private Disruption? disruption;
    private IReadOnlyList<ReplanOption> options = Array.Empty<ReplanOption>();
    private string identity = AgentAuthorizationService.RoleProducer;

    private bool isLoading = true;
    private bool isCommitting;
    private string? loadError;
    private string? commitError;
    private string? commitMessage;

    private int consolidateCap = 2;
    private bool isConsolidating;
    private bool isConsolidation;
    private string? consolidateError;

    protected override Task OnInitializedAsync() => LoadAsync();

    private async Task LoadAsync()
    {
        isLoading = true;
        loadError = null;
        StateHasChanged();

        try
        {
            var (raised, proposals) = await Replanner.GetLatestProposalsAsync();
            disruption = raised;
            options = proposals;
            isConsolidation = false;
        }
        catch (Exception ex)
        {
            loadError = ex.Message;
        }
        finally
        {
            isLoading = false;
        }
    }

    private async Task ConsolidateAsync()
    {
        isConsolidating = true;
        consolidateError = null;
        commitMessage = null;
        commitError = null;
        StateHasChanged();

        try
        {
            var (current, consolidated) = await Replanner.ProposeConsolidationAsync(consolidateCap);
            options = new[] { current, consolidated };
            isConsolidation = true;
        }
        catch (Exception ex)
        {
            // "No day visits more than N locations already" is a real answer, and a better
            // one than a re-solve that changed nothing dressed up as an improvement.
            consolidateError = ex.Message;
        }
        finally
        {
            isConsolidating = false;
        }
    }

    private async Task CommitAsync(ReplanOption option)
    {
        isCommitting = true;
        commitError = null;
        commitMessage = null;
        StateHasChanged();

        try
        {
            // A human at a browser session, acting as the role they selected above. The
            // governance story is about agents being unable to decide — a production
            // deployment would put this page behind IAP and take the role from the login
            // rather than from a dropdown (ADR-020).
            var caller = identity == AgentAuthorizationService.RoleProducer
                ? CallerIdentity.FromHumanSession(identity)
                : CallerIdentity.Asserted(identity);

            var board = await Schedules.CommitAsync(option.VersionId, caller);
            commitMessage = $"Schedule v{board.VersionNumber} committed by {identity}. "
                          + $"{board.Metrics.TotalDays} days, {board.Metrics.CompanyMoves} moves, "
                          + $"{board.Metrics.EstimatedCostUsd.ToString("C0", Culture)}.";

            // Re-mark in place rather than reloading: a reload would swap the consolidation
            // options back for the disruption's, and the producer would lose the screen they
            // just decided on. What has to change is which card is in force.
            options = options
                .Select(o => o with { IsCommitted = o.VersionId == board.VersionId })
                .ToList();
        }
        catch (ScheduleService.NotAuthorizedException ex)
        {
            commitError = ex.Message;
        }
        catch (Exception ex)
        {
            commitError = ex.Message;
        }
        finally
        {
            isCommitting = false;
        }
    }

    private static string Signed(int value) => value >= 0 ? $"+{value}" : value.ToString();
}
