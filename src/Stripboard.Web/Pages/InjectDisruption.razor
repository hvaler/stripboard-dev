@page "/inject-disruption"
@using Microsoft.EntityFrameworkCore
@using Stripboard.Application.Common.Models
@using Stripboard.Domain.Entities
@using Stripboard.Domain.Enums
@using Stripboard.Infrastructure.Persistence
@using Stripboard.Application.Services
@using Stripboard.Infrastructure.Services
@inject StripboardDbContext DbContext
@inject ReplanService Replanner
@inject ScheduleService Schedules

<PageTitle>Inject Disruption — Stripboard</PageTitle>

<h1 class="mb-3">Disruption injector</h1>

<p class="text-muted">
    A disruption is translated into scene-day constraints and handed to the CP-SAT solver, which
    re-solves the shoot. The options and their cost deltas come from those solver runs.
</p>

@if (baseline is null)
{
    <div class="alert alert-warning">No committed schedule to disrupt. Generate one from the stripboard first.</div>
}
else
{
    <div class="alert alert-secondary d-flex justify-content-between align-items-center">
        <span>
            Disrupting <strong>v@(baseline.VersionNumber)</strong> —
            @baseline.Metrics.TotalDays days, @baseline.Metrics.CompanyMoves moves,
            @baseline.Metrics.EstimatedCostUsd.ToString("C0", Culture)
        </span>
        @if (baseline.Days.Count > 0)
        {
            <span class="text-muted small">Shoot starts @baseline.Days[0].Date.ToString("yyyy-MM-dd")</span>
        }
    </div>

    <div class="row g-4">
        <div class="col-md-6">
            <div class="card shadow-sm border-danger h-100">
                <div class="card-header bg-danger text-white"><h5 class="mb-0">Cast unavailability</h5></div>
                <div class="card-body">
                    <label class="form-label fw-semibold">Cast member</label>
                    <select class="form-select mb-3" @bind="selectedPersonId" disabled="@isWorking">
                        @foreach (var person in cast)
                        {
                            <option value="@person.Id">@person.Name (@person.DailyRate.ToString("C0", Culture)/day)</option>
                        }
                    </select>

                    <label class="form-label fw-semibold">Unavailable from</label>
                    <input type="date" class="form-control mb-3" @bind="castDate" disabled="@isWorking" />

                    <label class="form-label fw-semibold">Days</label>
                    <input type="number" min="1" max="10" class="form-control" @bind="castDuration" disabled="@isWorking" />
                </div>
                <div class="card-footer bg-white border-top-0 pb-3">
                    <button class="btn btn-danger w-100 fw-bold" @onclick="InjectCastAsync" disabled="@isWorking">
                        Inject cast unavailability
                    </button>
                </div>
            </div>
        </div>

        <div class="col-md-6">
            <div class="card shadow-sm border-warning h-100">
                <div class="card-header bg-warning text-dark"><h5 class="mb-0">Weather alert (exteriors)</h5></div>
                <div class="card-body">
                    <label class="form-label fw-semibold">Location <span class="text-muted fw-normal">(exteriors only)</span></label>
                    <select class="form-select mb-3" @bind="selectedLocation" disabled="@isWorking">
                        @foreach (var location in locations)
                        {
                            <option value="@location">@location</option>
                        }
                    </select>

                    <label class="form-label fw-semibold">Affected from</label>
                    <input type="date" class="form-control mb-3" @bind="weatherDate" disabled="@isWorking" />

                    <label class="form-label fw-semibold">Days</label>
                    <input type="number" min="1" max="10" class="form-control" @bind="weatherDuration" disabled="@isWorking" />
                </div>
                <div class="card-footer bg-white border-top-0 pb-3">
                    <button class="btn btn-warning w-100 fw-bold text-dark" @onclick="InjectWeatherAsync" disabled="@isWorking">
                        Inject weather alert
                    </button>
                </div>
            </div>
        </div>
    </div>
}

@if (isWorking)
{
    <div class="d-flex align-items-center gap-3 mt-4 p-4 bg-light border rounded">
        <div class="spinner-border text-danger" role="status"><span class="visually-hidden">Solving…</span></div>
        <div>
            <strong>Re-solving the shoot…</strong>
            <div class="text-muted small">Running CP-SAT once per replan strategy. This is not instant.</div>
        </div>
    </div>
}

@if (error is not null)
{
    <div class="alert alert-danger mt-4">
        <h5 class="alert-heading fw-bold">Could not replan</h5>
        <p class="mb-0">@error</p>
    </div>
}

@if (result is not null)
{
    <div class="alert alert-success mt-4">
        <h5 class="alert-heading fw-bold">Disruption recorded — @result.Count option(s) produced</h5>
        <ul class="mb-3">
            @foreach (var option in result)
            {
                <li>
                    <strong>@option.Title</strong> —
                    @if (option.IsFeasible)
                    {
                        <span>
                            @option.Metrics.TotalDays days
                            (@(option.Delta.ExtraShootDays >= 0 ? "+" : "")@option.Delta.ExtraShootDays),
                            delta @option.Delta.CostDeltaUsd.ToString("C0", Culture)
                        </span>
                    }
                    else
                    {
                        <span class="text-danger">infeasible under these constraints</span>
                    }
                </li>
            }
        </ul>
        <a href="proposals" class="btn btn-primary btn-sm fw-bold">Review and approve</a>
    </div>
}


@* ── Rehearsal control (EV-36) ─────────────────────────────────────────────────────
   Not a cheat and not hidden. The alert loop is the thing worth showing, and a
   recording needs it to happen on cue rather than when the shoot happens to drift.
   Both buttons do exactly what the label says: re-solve and commit a schedule that is
   genuinely better or genuinely worse. Nothing is faked and no metric is written by
   hand — Grafana still decides whether that schedule breaks a rule. *@
<div class="card border-secondary mt-4">
    <div class="card-header bg-secondary text-white">Rehearsal — arm the alert loop</div>
    <div class="card-body">
        <p class="text-secondary mb-3">
            For demonstrating the loop on camera. <strong>Arm</strong> commits a schedule with
            no cap on locations per day, so a day visits four and Grafana's
            <em>unit hopping</em> rule starts firing after its five-minute window.
            <strong>Settle</strong> commits the consolidated schedule again and the rule clears.
            Both are real CP-SAT runs approved as the Producer; the difference is which
            constraint they were solved under.
        </p>

        @if (rehearsalMessage is not null)
        {
            <div class="alert alert-success py-2">@rehearsalMessage</div>
        }
        @if (rehearsalError is not null)
        {
            <div class="alert alert-danger py-2">@rehearsalError</div>
        }

        <div class="d-flex gap-2">
            <button class="btn btn-warning fw-bold" disabled="@isRehearsing"
                    @onclick='() => RehearseAsync(null, "Armed")'>
                Arm — commit an unconstrained schedule
            </button>
            <button class="btn btn-outline-secondary" disabled="@isRehearsing"
                    @onclick='() => RehearseAsync(2, "Settled")'>
                Settle — cap the day at 2 locations
            </button>
        </div>
        @if (isRehearsing)
        {
            <div class="mt-3"><Busy Label="Re-solving and committing" /></div>
        }
    </div>
</div>

@code {
    private static readonly System.Globalization.CultureInfo Culture = System.Globalization.CultureInfo.GetCultureInfo("en-US");

    private ScheduleBoard? baseline;
    private List<Person> cast = new();
    private List<string> locations = new();

    private Guid selectedPersonId;
    private string selectedLocation = string.Empty;
    private DateTime castDate = DateTime.Today;
    private DateTime weatherDate = DateTime.Today;
    private int castDuration = 1;
    private int weatherDuration = 1;

    private bool isWorking;
    private string? error;
    private IReadOnlyList<ReplanOption>? result;

    protected override async Task OnInitializedAsync()
    {
        baseline = await Schedules.GetActiveBoardAsync();

        cast = await DbContext.People.AsNoTracking()
            .Where(p => p.Role == PersonRole.Cast)
            .OrderBy(p => p.Name)
            .ToListAsync();

        // Only exteriors: weather cannot disrupt a scene shot on an interior set, so
        // offering interiors here would just produce "this affects nothing" every time.
        locations = await DbContext.Scenes.AsNoTracking()
            .Where(s => s.IntExt == IntExt.Ext || s.IntExt == IntExt.IntExt)
            .Select(s => s.SetLocation)
            .Distinct()
            .OrderBy(l => l)
            .ToListAsync();

        selectedPersonId = cast.FirstOrDefault()?.Id ?? Guid.Empty;
        selectedLocation = locations.FirstOrDefault() ?? string.Empty;

        if (baseline is { Days.Count: > 0 })
        {
            castDate = baseline.Days[0].Date.ToDateTime(TimeOnly.MinValue);
            weatherDate = castDate;
        }
    }

    private Task InjectCastAsync()
    {
        var person = cast.FirstOrDefault(p => p.Id == selectedPersonId);
        if (person is null)
        {
            error = "Select a cast member first.";
            return Task.CompletedTask;
        }

        return ProposeAsync(new DisruptionRequest(
            TriggerType.CastUnavailability,
            DateOnly.FromDateTime(castDate),
            castDuration,
            person.Id,
            null,
            $"{person.Name} is unavailable for {castDuration} day(s) from {castDate:yyyy-MM-dd}."));
    }

    private Task InjectWeatherAsync() => ProposeAsync(new DisruptionRequest(
        TriggerType.WeatherAlert,
        DateOnly.FromDateTime(weatherDate),
        weatherDuration,
        null,
        selectedLocation,
        $"Severe weather forecast at {selectedLocation} for {weatherDuration} day(s) from {weatherDate:yyyy-MM-dd}."));

    private async Task ProposeAsync(DisruptionRequest request)
    {
        isWorking = true;
        error = null;
        result = null;
        StateHasChanged();

        try
        {
            var (_, options) = await Replanner.ProposeAsync(request);
            result = options;
        }
        catch (Exception ex)
        {
            error = ex.Message;
        }
        finally
        {
            isWorking = false;
        }
    }

    private bool isRehearsing;
    private string? rehearsalMessage;
    private string? rehearsalError;

    /// <summary>
    /// Re-solves under the given cap and commits the result as the Producer.
    ///
    /// A human pressed the button, so the commit goes in as a human session — the governance
    /// rule is about agents not deciding, and this is not an agent. What it is not allowed to
    /// do is write a metric: the schedule is real, and whether it breaks a rule is still
    /// Grafana's answer to give.
    /// </summary>
    private async Task RehearseAsync(int? maxLocationsPerDay, string verb)
    {
        isRehearsing = true;
        rehearsalMessage = null;
        rehearsalError = null;
        StateHasChanged();

        try
        {
            var draft = await Schedules.GenerateAsync(
                AgentAuthorizationService.RoleProducer,
                startDate: new DateOnly(2026, 8, 10),
                maxLocationsPerDay: maxLocationsPerDay);

            var board = await Schedules.CommitAsync(draft.VersionId,
                CallerIdentity.FromHumanSession(AgentAuthorizationService.RoleProducer));

            var worstDay = board.Days.Count == 0 ? 0 : board.Days.Max(d => d.Locations.Count);
            rehearsalMessage =
                $"{verb}. v{board.VersionNumber} committed: {board.Metrics.TotalDays} days, "
                + $"worst day visits {worstDay} location{(worstDay == 1 ? "" : "s")}, "
                + $"{board.Metrics.EstimatedCostUsd.ToString("C0", Culture)}. "
                + (worstDay > 2
                    ? "Grafana evaluates every minute and the rule fires after five, so give it that long."
                    : "The unit-hopping rule has nothing to fire on now.");
        }
        catch (Exception ex)
        {
            rehearsalError = ex.Message;
        }
        finally
        {
            isRehearsing = false;
        }
    }
}
