@page "/callsheets"
@using Stripboard.CallSheets.Services
@inject CallSheetPdfGenerator PdfGenerator
@inject IJSRuntime JS

<PageTitle>Call Sheets — Stripboard</PageTitle>

<h1 class="mb-4">📋 Call Sheet Distribution & Role Access</h1>

<p class="text-muted">
    View and download personalized daily Call Sheets generated in cascade upon schedule commitment.
</p>

<div class="card shadow-sm mb-4">
    <div class="card-body">
        <div class="row g-3 align-items-end">
            <div class="col-md-4">
                <label class="form-label fw-bold">Select Person / Role:</label>
                <select class="form-select" @bind="selectedPerson">
                    <option value="Sherlock Holmes">Sherlock Holmes (Lead Cast — 06:00 AM Call)</option>
                    <option value="Prof. James Moriarty">Prof. James Moriarty (Supporting Cast — 07:30 AM Call)</option>
                    <option value="Director of Photography">Director of Photography (Crew — 05:30 AM Call)</option>
                </select>
            </div>
            <div class="col-md-3">
                <label class="form-label fw-bold">Shoot Date:</label>
                <input type="date" class="form-control" value="2026-08-10" />
            </div>
            <div class="col-md-5 d-flex gap-2">
                <button class="btn btn-primary fw-bold" @onclick="DownloadPdf">
                    ⬇️ Download Call Sheet (PDF)
                </button>
            </div>
        </div>
    </div>
</div>

<!-- Preview Card -->
<div class="card shadow-sm border-secondary">
    <div class="card-header bg-dark text-white d-flex justify-content-between align-items-center">
        <h5 class="mb-0">Preview: Call Sheet for @selectedPerson</h5>
        <span class="badge bg-info text-dark">CONFIDENTIAL</span>
    </div>
    <div class="card-body">
        <div class="row mb-3">
            <div class="col-md-6">
                <h6>🎬 Production: <strong>SHERLOCK HOLMES: THE DEVIL'S MILE</strong></h6>
                <h6>📅 Date: <strong>2026-08-10 (Day 1 of 5)</strong></h6>
                <h6>⏰ Call Time: <strong class="text-danger">@GetCallTime()</strong></h6>
            </div>
            <div class="col-md-6 text-end">
                <h6>🌅 Sunrise: <strong>05:42 AM</strong> | 🌇 Sunset: <strong>08:35 PM</strong></h6>
                <h6>☁️ Weather: <strong>22°C, Sunny (10% precip)</strong></h6>
                <h6>📍 Location: <strong>221B BAKER STREET, LONDON</strong></h6>
            </div>
        </div>

        <table class="table table-bordered table-striped align-middle">
            <thead class="table-primary">
                <tr>
                    <th>Scene #</th>
                    <th>Set / Location</th>
                    <th>INT/EXT</th>
                    <th>D/N</th>
                    <th>Cast</th>
                </tr>
            </thead>
            <tbody>
                <tr>
                    <td><strong>#1</strong></td>
                    <td>221B BAKER STREET — SITTING ROOM</td>
                    <td><span class="badge bg-secondary">INT</span></td>
                    <td><span class="badge bg-warning text-dark">DAY</span></td>
                    <td>Sherlock Holmes, Dr. John Watson</td>
                </tr>
                <tr>
                    <td><strong>#2</strong></td>
                    <td>221B BAKER STREET — FOYER</td>
                    <td><span class="badge bg-secondary">INT</span></td>
                    <td><span class="badge bg-dark">NIGHT</span></td>
                    <td>Sherlock Holmes, Prof. James Moriarty</td>
                </tr>
            </tbody>
        </table>
    </div>
</div>

@code {
    private string selectedPerson = "Sherlock Holmes";

    private string GetCallTime() => selectedPerson switch
    {
        "Sherlock Holmes" => "06:00 AM",
        "Prof. James Moriarty" => "07:30 AM",
        _ => "05:30 AM"
    };

    private async Task DownloadPdf()
    {
        var data = new CallSheetData(
            ProductionTitle: "SHERLOCK HOLMES: THE DEVIL'S MILE",
            ShootDate: new DateOnly(2026, 8, 10),
            DayNumber: 1,
            TotalDays: 5,
            PersonName: selectedPerson,
            RoleTitle: selectedPerson.Contains("Director") ? "Crew" : "Cast",
            IndividualCallTime: GetCallTime(),
            SunriseTime: "05:42 AM",
            SunsetTime: "08:35 PM",
            WeatherSummary: "22°C, Sunny (10% precip)",
            PrimaryLocation: "221B BAKER STREET, LONDON",
            Scenes: new List<CallSheetSceneItem>
            {
                new(1, "221B BAKER STREET — SITTING ROOM", "INT", "DAY", "Sherlock Holmes, Dr. John Watson", "Cast #1, #2"),
                new(2, "221B BAKER STREET — FOYER", "INT", "NIGHT", "Sherlock Holmes, Prof. James Moriarty", "Cast #1, #3")
            }
        );

        byte[] pdfBytes = PdfGenerator.GenerateCallSheetPdf(data);
        string base64 = Convert.ToBase64String(pdfBytes);
        await JS.InvokeVoidAsync("eval", $"const a = document.createElement('a'); a.href = 'data:application/pdf;base64,{base64}'; a.download = 'CallSheet_{selectedPerson.Replace(" ", "_")}.pdf'; a.click();");
    }
}
