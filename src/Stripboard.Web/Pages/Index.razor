@page "/"
@using Stripboard.Application.Common.Models
@using Stripboard.Domain.Enums
@using Stripboard.Infrastructure.Services
@inject ScheduleService Schedules
@inject Stripboard.Web.Services.SentinelClient Sentinel

<PageTitle>Stripboard — Autonomous Line Producer</PageTitle>

<div class="d-flex flex-wrap justify-content-between align-items-end gap-3 mb-4 pb-3 border-bottom">
    <div>
        <h1 class="mb-1">Shooting stripboard</h1>
        <p class="page-intro mb-0">
            Computed by the Google OR-Tools CP-SAT solver. Union rules are enforced by the
            domain layer, not by a prompt.
        </p>
    </div>
    <div class="d-flex gap-2">
        <a class="btn btn-danger" href="inject-disruption">Inject disruption</a>
        <a class="btn btn-primary" href="proposals">Proposals</a>
        <a class="btn btn-secondary" href="callsheets">Call sheets</a>
    </div>
</div>

@if (isLoading)
{
    <Busy Label="Reading the committed schedule"
          Hint="The board is the result of a CP-SAT run, read back from the version that was approved." />
}
else if (error is not null)
{
    <div class="alert alert-danger">
        <h5 class="alert-heading fw-bold">Could not load the schedule</h5>
        <p class="mb-2">@error</p>
        <button class="btn btn-outline-danger btn-sm" @onclick="LoadAsync">Retry</button>
    </div>
}
else if (board is null || board.Days.Count == 0)
{
    <div class="alert alert-warning">
        <h5 class="alert-heading fw-bold">No schedule yet</h5>
        <p class="mb-0">
            No committed schedule version exists. Import a screenplay breakdown and run the solver
            to produce one.
        </p>
    </div>
}
else
{
    var worstDay = board.Days.Count == 0 ? 0 : board.Days.Max(d => d.Locations.Count);

    @* EV-36 — the loop was already running and nobody could see it. Two rules fire on this
       shoot right now; the public dashboard shows panels, not alert states, and a rule's
       state needs a Grafana session. So it is said here, on the page an anonymous visitor
       lands on, read back from Grafana over MCP rather than re-evaluated locally. *@
    @if (alerts.Count > 0)
    {
        <div class="alert alert-warning border-start border-4 border-warning">
            <div class="d-flex flex-wrap justify-content-between align-items-start gap-2">
                <strong>
                    Grafana has @alerts.Count rule@(alerts.Count == 1 ? "" : "s") firing on this shoot.
                </strong>
                <a class="small" target="_blank" rel="noopener"
                   href="https://pinkcorridor3522.grafana.net/public-dashboards/1e372a04e0974e1fa34afb2e143957c3">
                    Open Shoot Mission Control →
                </a>
            </div>
            <ul class="mb-0 mt-2 small">
                @foreach (var alert in alerts)
                {
                    <li>
                        <strong>@alert.Title</strong>
                        @if (!string.IsNullOrWhiteSpace(alert.Action))
                        {
                            <span class="badge bg-dark ms-1">@alert.Action</span>
                        }
                        @if (!string.IsNullOrWhiteSpace(alert.Summary))
                        {
                            <div class="text-muted">@alert.Summary</div>
                        }
                    </li>
                }
            </ul>
            <div class="small text-muted mt-2">
                Nobody pressed anything to find this out. The shoot exports its own metrics, a rule
                in Grafana evaluates them, and the Conflict Sentinel reads the firing ones back over
                the MCP server.
            </div>
        </div>
    }
    else if (alertsUnavailable is not null)
    {
        @* An unreachable sentinel is not a quiet shoot, and saying so would be the exact
           failure the alert rules exist to prevent. *@
        <div class="alert alert-secondary small">
            Could not read the alert state from Grafana, so this page cannot say whether anything
            is firing: @alertsUnavailable
        </div>
    }

    <div class="figures">
        <div class="figure">
            <div class="figure-label">Shooting days</div>
            <div class="figure-value">@board.Metrics.TotalDays</div>
            <div class="figure-note">@board.Metrics.TotalEighths eighths scheduled</div>
        </div>
        <div class="figure @(board.Metrics.UnionViolations == 0 ? "is-good" : "is-danger")">
            <div class="figure-label">Union rules</div>
            <div class="figure-value">
                @(board.Metrics.UnionViolations == 0 ? "Clean" : board.Metrics.UnionViolations.ToString())
            </div>
            <div class="figure-note">
                @(board.Metrics.UnionViolations == 0
                    ? "Turnaround holds by construction"
                    : "violation(s) — this is legal exposure")
            </div>
        </div>
        <div class="figure @(worstDay > 2 ? "is-warn" : "")">
            <div class="figure-label">Company moves</div>
            <div class="figure-value">@board.Metrics.CompanyMoves</div>
            <div class="figure-note">worst day visits @worstDay location@(worstDay == 1 ? "" : "s")</div>
        </div>
        <div class="figure is-accent">
            <div class="figure-label">Estimated cost</div>
            <div class="figure-value">@board.Metrics.EstimatedCostUsd.ToString("C0", Culture)</div>
            <div class="figure-note">crew and called cast, moves and penalties</div>
        </div>
    </div>

    <div class="d-flex justify-content-between align-items-end mb-3">
        <h4 class="mb-0">Master schedule</h4>
        <span class="text-muted small">
            Version <strong>v@(board.VersionNumber)</strong>
            @if (board.IsCommitted)
            {
                <span class="badge bg-success ms-1">Committed</span>
            }
            else
            {
                <span class="badge bg-warning text-dark ms-1">Draft</span>
            }
            · proposed by @board.CreatedBy · @board.CreatedAt.ToString("yyyy-MM-dd HH:mm") UTC
            @if (board.IsCommitted)
            {
                @* Two names, because they are two people. The proposer is usually an agent; the
                   approver can only ever be a human Producer. *@
                <text>· approved by </text>
                @if (string.IsNullOrWhiteSpace(board.ApprovedBy))
                {
                    <span class="text-muted" title="This version was committed before the approver was recorded separately from the proposer.">not recorded</span>
                }
                else
                {
                    <strong>@board.ApprovedBy</strong>
                    @if (board.ApprovedAt is { } approvedAt)
                    {
                        <text> · @approvedAt.ToString("yyyy-MM-dd HH:mm") UTC</text>
                    }
                }
            }
            · @board.Metrics.TotalEighths eighths
        </span>
    </div>

    @if (board.Anomalies.Count > 0)
    {
        <div class="alert alert-warning">
            <strong>@board.Anomalies.Count union anomal@(board.Anomalies.Count == 1 ? "y" : "ies") detected:</strong>
            <ul class="mb-0 mt-2">
                @foreach (var anomaly in board.Anomalies)
                {
                    <li><span class="badge bg-danger me-1">@anomaly.Severity</span> @anomaly.Message</li>
                }
            </ul>
        </div>
    }

    @* The colour code every 1st AD reads without thinking. Spelled out, because a code
       nobody can decipher is decoration. *@
    <div class="legend">
        <span><i class="int-day"></i> Int · Day</span>
        <span><i class="ext-day"></i> Ext · Day</span>
        <span><i class="int-night"></i> Int · Night</span>
        <span><i class="ext-night"></i> Ext · Night</span>
    </div>

    @if (NeedsPaging)
    {
        @* Only when it earns its place. A four-day shoot paginated is a control that does
           nothing but take up room; a feature at 29 days without one is a page nobody can
           read. The threshold is what a producer can hold on screen at once. *@
        <nav class="d-flex justify-content-between align-items-center mb-3" aria-label="Shooting days">
            <button class="btn btn-outline-secondary btn-sm" @onclick="PreviousDays" disabled="@(dayPage == 0)">
                ← Earlier days
            </button>
            <span class="small text-muted" role="status" aria-live="polite">
                Days @(FirstDay)–@(LastDay) of @board.Days.Count
            </span>
            <button class="btn btn-outline-secondary btn-sm" @onclick="NextDays" disabled="@(dayPage >= DayPageCount - 1)">
                Later days →
            </button>
        </nav>
    }

    <div class="board">
        @foreach (var day in VisibleDays(board))
        {
            var isNight = day.CallTime.Hour >= 12;
            <section class="shoot-day">
                <header class="day-header">
                    <span class="day-number">Day @day.DayNumber</span>
                    <span class="day-date">@day.Date.ToString("ddd d MMM yyyy", Culture)</span>
                    <span class="unit-badge @(isNight ? "is-night" : "is-day")">
                        @(isNight ? "Night unit" : "Day unit")
                    </span>
                    <div class="day-meta">
                        <span>Call <b>@day.CallTime.ToString("HH:mm")</b></span>
                        <span>Wrap <b>@day.WrapTime.ToString("HH:mm")</b></span>
                        @if (day.DayNumber > 1)
                        {
                            <span>
                                Turnaround
                                <b style="color: @(day.TurnaroundHoursFromPreviousDay >= 12 ? "var(--ext-night)" : "var(--danger)")">
                                    @* With no culture this renders "20,5h" on a Spanish machine
                                       and "20.5h" on an English one — the same page reading
                                       differently depending on where the container happens to
                                       run. The fourth locale-default bug in this project. *@
                                    @day.TurnaroundHoursFromPreviousDay.ToString("0.#", Culture)h
                                </b>
                            </span>
                        }
                        <span><b>@day.Scenes.Sum(s => s.Eighths)/8</b> pages</span>
                    </div>
                </header>

                @foreach (var scene in day.Scenes)
                {
                    <div class="strip @StripClass(scene)">
                        <div class="strip-colour"></div>
                        <div class="strip-scene">@scene.Number</div>
                        <div class="strip-where">
                            <div class="strip-location">
                                @LocationOf(scene)@if (SetOf(scene) is { } set)
                                {
                                    <span class="strip-set"> · @set</span>
                                }
                            </div>
                            <div class="strip-detail">
                                @(scene.Cast.Count == 0 ? scene.Synopsis : string.Join(", ", scene.Cast))
                            </div>
                        </div>
                        <div class="strip-right">
                            <span class="strip-type">@Label(scene)</span>
                            <span class="strip-eighths">@scene.Eighths/8</span>
                        </div>
                    </div>
                }

                @if (day.Locations.Count > 2)
                {
                    <div class="day-warning">
                        @day.Locations.Count locations in one day —
                        @(day.Locations.Count - 1) company move@(day.Locations.Count == 2 ? "" : "s"),
                        roughly that many hours of light spent moving the unit.
                    </div>
                }
            </section>
        }
    </div>

    <p class="text-muted small mt-3 mb-0">@board.SolverMessage</p>
}

@code {
    private static readonly System.Globalization.CultureInfo Culture = System.Globalization.CultureInfo.GetCultureInfo("en-US");

    private ScheduleBoard? board;
    // A shooting day is a tall block, so about eight is what fits on a screen before the page
    // turns into scrolling. Below that the control is hidden entirely rather than disabled:
    // a paginator on a four-day shoot is furniture.
    private const int DaysPerPage = 8;

    private int dayPage;

    private bool NeedsPaging => board is not null && board.Days.Count > DaysPerPage;
    private int DayPageCount => board is null ? 1 : Math.Max(1, (int)Math.Ceiling(board.Days.Count / (double)DaysPerPage));
    private int FirstDay => dayPage * DaysPerPage + 1;
    private int LastDay => board is null ? 0 : Math.Min(board.Days.Count, (dayPage + 1) * DaysPerPage);

    private IEnumerable<BoardDay> VisibleDays(ScheduleBoard b) =>
        NeedsPaging ? b.Days.Skip(dayPage * DaysPerPage).Take(DaysPerPage) : b.Days;

    private void PreviousDays() => dayPage = Math.Max(0, dayPage - 1);
    private void NextDays() => dayPage = Math.Min(DayPageCount - 1, dayPage + 1);

    private IReadOnlyList<Stripboard.Web.Services.FiringAlert> alerts = [];
    private string? alertsUnavailable;

    private bool isLoading = true;
    private string? error;

    protected override Task OnInitializedAsync() => LoadAsync();

    private async Task LoadAsync()
    {
        isLoading = true;
        error = null;
        StateHasChanged();

        try
        {
            board = await Schedules.GetActiveBoardAsync();
        }
        catch (Exception ex)
        {
            error = ex.Message;
        }
        finally
        {
            isLoading = false;
        }

        // Deliberately after the board and outside its try: the schedule is what this page is
        // for, and a sentinel that is down must not stop it rendering. The alert strip either
        // appears or says it could not tell — it never silently reports a quiet shoot.
        await LoadAlertsAsync();
    }

    private async Task LoadAlertsAsync()
    {
        try
        {
            alerts = await Sentinel.FiringAlertsAsync();
            alertsUnavailable = null;
        }
        catch (Exception ex)
        {
            alerts = [];
            alertsUnavailable = ex.Message;
        }
    }

    /// <summary>
    /// The industry strip colour: white INT DAY, yellow EXT DAY, blue INT NIGHT, green EXT
    /// NIGHT. Dusk and dawn take the night colours, because magic hour is planned against
    /// fading light rather than against a lunch break.
    /// </summary>
    private static string StripClass(BoardScene scene)
    {
        var night = scene.DayNight is DayNight.Night or DayNight.Dusk or DayNight.Dawn;
        var exterior = scene.IntExt is IntExt.Ext or IntExt.IntExt;

        return (night, exterior) switch
        {
            (true, true) => "ext-night",
            (true, false) => "int-night",
            (false, true) => "ext-day",
            _ => "int-day",
        };
    }

    // The board separates the place the trucks park from the set inside it, because moving
    // between two rooms of one building is not a company move (ADR-013).
    private static string LocationOf(BoardScene scene) => Split(scene.SetLocation).Location;

    private static string? SetOf(BoardScene scene) => Split(scene.SetLocation).Set;

    private static (string Location, string? Set) Split(string setLocation)
    {
        var separator = setLocation.IndexOf('/');
        return separator > 0
            ? (setLocation[..separator].TrimEnd(), setLocation[(separator + 1)..].TrimStart())
            : (setLocation, null);
    }

    private static string Label(BoardScene scene)
    {
        var prefix = scene.IntExt switch
        {
            IntExt.Ext => "EXT",
            IntExt.IntExt => "INT/EXT",
            _ => "INT",
        };
        return $"{prefix}. {scene.DayNight.ToString().ToUpperInvariant()}";
    }
}
