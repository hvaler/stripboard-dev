@page "/"
@using Stripboard.Application.Common.Models
@using Stripboard.Domain.Enums
@using Stripboard.Infrastructure.Services
@inject ScheduleService Schedules

<PageTitle>Stripboard — Autonomous Line Producer</PageTitle>

<div class="d-flex justify-content-between align-items-center mb-4 pb-2 border-bottom">
    <div>
        <h1 class="display-6 fw-bold mb-0">🎬 Shooting Stripboard</h1>
        <p class="text-muted mb-0">
            Schedule computed by the Google OR-Tools CP-SAT solver; union rules validated by the domain layer.
        </p>
    </div>
    <div class="d-flex gap-2">
        <a class="btn btn-danger fw-bold" href="inject-disruption">⚡ Inject Disruption</a>
        <a class="btn btn-primary fw-bold" href="proposals">⚖️ Proposals</a>
        <a class="btn btn-secondary fw-bold" href="callsheets">📋 Call Sheets</a>
    </div>
</div>

@if (isLoading)
{
    <div class="d-flex align-items-center gap-3 p-4 bg-light border rounded">
        <div class="spinner-border text-primary" role="status"><span class="visually-hidden">Solving…</span></div>
        <div>
            <strong>Loading the schedule…</strong>
            <div class="text-muted small">Reading the committed version produced by the CP-SAT solver.</div>
        </div>
    </div>
}
else if (error is not null)
{
    <div class="alert alert-danger">
        <h5 class="alert-heading fw-bold">Could not load the schedule</h5>
        <p class="mb-2">@error</p>
        <button class="btn btn-outline-danger btn-sm" @onclick="LoadAsync">Retry</button>
    </div>
}
else if (board is null || board.Days.Count == 0)
{
    <div class="alert alert-warning">
        <h5 class="alert-heading fw-bold">No schedule yet</h5>
        <p class="mb-0">
            No committed schedule version exists. Import a screenplay breakdown and run the solver
            to produce one.
        </p>
    </div>
}
else
{
    <div class="row mb-4">
        <div class="col-md-3">
            <div class="card bg-primary text-white shadow-sm">
                <div class="card-body">
                    <h6 class="card-subtitle mb-1 opacity-75">Total Shoot Days</h6>
                    <h2 class="card-title fw-bold mb-0">@board.Metrics.TotalDays days</h2>
                </div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card @(board.Metrics.UnionViolations == 0 ? "bg-success" : "bg-danger") text-white shadow-sm">
                <div class="card-body">
                    <h6 class="card-subtitle mb-1 opacity-75">Union Rule Status</h6>
                    <h2 class="card-title fw-bold mb-0">
                        @(board.Metrics.UnionViolations == 0 ? "Compliant" : $"{board.Metrics.UnionViolations} violation(s)")
                    </h2>
                </div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card bg-info text-white shadow-sm">
                <div class="card-body">
                    <h6 class="card-subtitle mb-1 opacity-75">Company Moves</h6>
                    <h2 class="card-title fw-bold mb-0">@board.Metrics.CompanyMoves moves</h2>
                </div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card bg-dark text-white shadow-sm">
                <div class="card-body">
                    <h6 class="card-subtitle mb-1 opacity-75">Estimated Cost</h6>
                    <h2 class="card-title fw-bold mb-0">@board.Metrics.EstimatedCostUsd.ToString("C0", Culture)</h2>
                </div>
            </div>
        </div>
    </div>

    <div class="d-flex justify-content-between align-items-end mb-3">
        <h4 class="fw-bold mb-0">📅 Master Schedule</h4>
        <span class="text-muted small">
            Version <strong>v@(board.VersionNumber)</strong>
            @if (board.IsCommitted)
            {
                <span class="badge bg-success ms-1">Committed</span>
            }
            else
            {
                <span class="badge bg-warning text-dark ms-1">Draft</span>
            }
            · created by @board.CreatedBy · @board.CreatedAt.ToString("yyyy-MM-dd HH:mm") UTC
            · @board.Metrics.TotalEighths eighths
        </span>
    </div>

    @if (board.Anomalies.Count > 0)
    {
        <div class="alert alert-warning">
            <strong>@board.Anomalies.Count union anomal@(board.Anomalies.Count == 1 ? "y" : "ies") detected:</strong>
            <ul class="mb-0 mt-2">
                @foreach (var anomaly in board.Anomalies)
                {
                    <li><span class="badge bg-danger me-1">@anomaly.Severity</span> @anomaly.Message</li>
                }
            </ul>
        </div>
    }

    <div class="table-responsive shadow-sm rounded border">
        <table class="table table-hover align-middle mb-0">
            <thead class="table-dark">
                <tr>
                    <th style="width: 90px;">Day</th>
                    <th style="width: 80px;">Scene</th>
                    <th style="width: 130px;">Type</th>
                    <th>Location &amp; Setting</th>
                    <th>Cast</th>
                    <th style="width: 90px;">Pages</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var day in board.Days)
                {
                    <tr class="table-secondary fw-bold">
                        <td colspan="6">
                            📆 DAY @day.DayNumber — @day.Date.ToString("dddd, MMM d, yyyy", Culture)
                            (Call @day.CallTime.ToString("HH:mm") · Wrap @day.WrapTime.ToString("HH:mm"))
                            @if (day.Locations.Count > 1)
                            {
                                <span class="badge bg-info text-dark ms-2">@day.Locations.Count locations</span>
                            }
                            @if (day.DayNumber > 1)
                            {
                                <span class="badge @(day.TurnaroundHoursFromPreviousDay >= 12 ? "bg-success" : "bg-danger") ms-1">
                                    @day.TurnaroundHoursFromPreviousDay.ToString("0.#")h turnaround
                                </span>
                            }
                        </td>
                    </tr>
                    @foreach (var scene in day.Scenes)
                    {
                        <tr class="@RowClass(scene)">
                            <td class="fw-bold text-center">Day @day.DayNumber</td>
                            <td><span class="badge bg-dark">#@scene.Number</span></td>
                            <td><span class="badge @BadgeClass(scene)">@Label(scene)</span></td>
                            <td>
                                <strong>@scene.SetLocation</strong>
                                <div class="small text-muted">@scene.Synopsis</div>
                            </td>
                            <td>@(scene.Cast.Count == 0 ? "—" : string.Join(", ", scene.Cast))</td>
                            <td>@scene.Eighths/8</td>
                        </tr>
                    }
                }
            </tbody>
        </table>
    </div>

    <p class="text-muted small mt-2 mb-0">@board.SolverMessage</p>
}

@code {
    private static readonly System.Globalization.CultureInfo Culture = System.Globalization.CultureInfo.GetCultureInfo("en-US");

    private ScheduleBoard? board;
    private bool isLoading = true;
    private string? error;

    protected override Task OnInitializedAsync() => LoadAsync();

    private async Task LoadAsync()
    {
        isLoading = true;
        error = null;
        StateHasChanged();

        try
        {
            board = await Schedules.GetActiveBoardAsync();
        }
        catch (Exception ex)
        {
            error = ex.Message;
        }
        finally
        {
            isLoading = false;
        }
    }

    private static string RowClass(BoardScene scene) => scene.DayNight switch
    {
        DayNight.Night => "table-info",
        DayNight.Dusk or DayNight.Dawn => "table-light",
        _ => scene.IntExt == IntExt.Ext ? "table-success" : "table-warning",
    };

    private static string BadgeClass(BoardScene scene) => scene.DayNight switch
    {
        DayNight.Night => "bg-primary",
        DayNight.Dusk or DayNight.Dawn => "bg-secondary",
        _ => scene.IntExt == IntExt.Ext ? "bg-success" : "bg-warning text-dark",
    };

    private static string Label(BoardScene scene)
    {
        var prefix = scene.IntExt switch
        {
            IntExt.Ext => "EXT",
            IntExt.IntExt => "INT/EXT",
            _ => "INT",
        };
        return $"{prefix}. {scene.DayNight.ToString().ToUpperInvariant()}";
    }
}
