@page "/"
@inject Stripboard.Infrastructure.Persistence.StripboardDbContext DbContext

<PageTitle>Stripboard — Autonomous Line Producer</PageTitle>

<div class="d-flex justify-content-between align-items-center mb-4 pb-2 border-bottom">
    <div>
        <h1 class="display-6 fw-bold mb-0">🎬 Shooting Stripboard (Master Schedule v1.0)</h1>
        <p class="text-muted mb-0">Automated schedule generated by OR-Tools CP-SAT solver enforcing SAG-AFTRA union rules.</p>
    </div>
    <div class="d-flex gap-2">
        <a class="btn btn-danger fw-bold" href="inject-disruption">⚡ Inject Disruption</a>
        <a class="btn btn-primary fw-bold" href="proposals">⚖️ Proposals</a>
        <a class="btn btn-secondary fw-bold" href="callsheets">📋 Call Sheets</a>
    </div>
</div>

<div class="row mb-4">
    <div class="col-md-3">
        <div class="card bg-primary text-white shadow-sm">
            <div class="card-body">
                <h6 class="card-subtitle mb-1 opacity-75">Total Shoot Days</h6>
                <h2 class="card-title fw-bold mb-0">5 Days</h2>
            </div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="card bg-success text-white shadow-sm">
            <div class="card-body">
                <h6 class="card-subtitle mb-1 opacity-75">Union Rule Status</h6>
                <h2 class="card-title fw-bold mb-0">100% Compliant</h2>
            </div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="card bg-info text-white shadow-sm">
            <div class="card-body">
                <h6 class="card-subtitle mb-1 opacity-75">Company Moves</h6>
                <h2 class="card-title fw-bold mb-0">2 Moves</h2>
            </div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="card bg-warning text-dark shadow-sm">
            <div class="card-body">
                <h6 class="card-subtitle mb-1 opacity-75">Active Version</h6>
                <h2 class="card-title fw-bold mb-0">v1.0 (Committed)</h2>
            </div>
        </div>
    </div>
</div>

<h4 class="fw-bold mb-3">📅 Master Schedule Stripboard</h4>

<div class="table-responsive shadow-sm rounded border">
    <table class="table table-hover align-middle mb-0">
        <thead class="table-dark">
            <tr>
                <th style="width: 100px;">Day / Date</th>
                <th style="width: 80px;">Scene</th>
                <th style="width: 140px;">Type / Daylight</th>
                <th>Location & Setting</th>
                <th>Cast Members</th>
                <th style="width: 140px;">Turnaround (12h)</th>
                <th style="width: 100px;">Status</th>
            </tr>
        </thead>
        <tbody>
            <!-- DAY 1 -->
            <tr class="table-secondary fw-bold">
                <td colspan="7">📆 DAY 1 — Monday, Aug 10, 2026 (Call Time: 07:00 AM)</td>
            </tr>
            <tr class="table-warning">
                <td class="fw-bold text-center">Day 1</td>
                <td><span class="badge bg-dark">#101</span></td>
                <td><span class="badge bg-warning text-dark">INT. DAY</span></td>
                <td><strong>221B Baker Street</strong> — Parlour Room</td>
                <td>Sherlock Holmes, Dr. John Watson</td>
                <td><span class="text-success fw-bold">14h Rest ✅</span></td>
                <td><span class="badge bg-success">Scheduled</span></td>
            </tr>
            <tr class="table-warning">
                <td class="fw-bold text-center">Day 1</td>
                <td><span class="badge bg-dark">#102</span></td>
                <td><span class="badge bg-warning text-dark">INT. DAY</span></td>
                <td><strong>221B Baker Street</strong> — Study Room</td>
                <td>Sherlock Holmes, Mrs. Hudson</td>
                <td><span class="text-success fw-bold">14h Rest ✅</span></td>
                <td><span class="badge bg-success">Scheduled</span></td>
            </tr>

            <!-- DAY 2 -->
            <tr class="table-secondary fw-bold">
                <td colspan="7">📆 DAY 2 — Tuesday, Aug 11, 2026 (Call Time: 07:00 AM)</td>
            </tr>
            <tr class="table-success">
                <td class="fw-bold text-center">Day 2</td>
                <td><span class="badge bg-dark">#201</span></td>
                <td><span class="badge bg-success">EXT. DAY</span></td>
                <td><strong>Tower Bridge Wharf</strong> — Dockside</td>
                <td>Sherlock Holmes, Prof. Moriarty</td>
                <td><span class="text-success fw-bold">12h Rest ✅</span></td>
                <td><span class="badge bg-success">Scheduled</span></td>
            </tr>
            <tr class="table-info text-dark">
                <td class="fw-bold text-center">Day 2</td>
                <td><span class="badge bg-dark">#202</span></td>
                <td><span class="badge bg-primary">EXT. NIGHT</span></td>
                <td><strong>Tower Bridge Wharf</strong> — Alleyway</td>
                <td>Sherlock Holmes, Inspector Lestrade</td>
                <td><span class="text-success fw-bold">13h Rest ✅</span></td>
                <td><span class="badge bg-success">Scheduled</span></td>
            </tr>

            <!-- DAY 3 -->
            <tr class="table-secondary fw-bold">
                <td colspan="7">📆 DAY 3 — Wednesday, Aug 12, 2026 (Call Time: 08:00 AM)</td>
            </tr>
            <tr class="table-warning">
                <td class="fw-bold text-center">Day 3</td>
                <td><span class="badge bg-dark">#301</span></td>
                <td><span class="badge bg-warning text-dark">INT. DAY</span></td>
                <td><strong>Scotland Yard</strong> — Forensics Lab</td>
                <td>Dr. John Watson, Inspector Lestrade</td>
                <td><span class="text-success fw-bold">15h Rest ✅</span></td>
                <td><span class="badge bg-success">Scheduled</span></td>
            </tr>
        </tbody>
    </table>
</div>

<div class="mt-4 p-4 bg-light rounded border shadow-sm">
    <div class="row align-items-center">
        <div class="col-md-8">
            <h5 class="fw-bold text-dark mb-1">⚡ Try the Real-Time Disruption Engine</h5>
            <p class="text-muted mb-0">Inject lead cast illness or severe weather alerts to watch Conflict Sentinel and Replanner Agent generate alternative proposals.</p>
        </div>
        <div class="col-md-4 text-end">
            <a class="btn btn-danger btn-lg fw-bold" href="inject-disruption">⚡ Open Disruption Injector</a>
        </div>
    </div>
</div>
