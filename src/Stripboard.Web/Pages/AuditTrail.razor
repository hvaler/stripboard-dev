@page "/audittrail"
@using Microsoft.EntityFrameworkCore
@using Stripboard.Infrastructure.Persistence
@using Stripboard.Domain.Entities
@inject StripboardDbContext DbContext

<PageTitle>Audit Trail — Stripboard</PageTitle>

<h1 class="mb-4">Governance audit trail</h1>

<p class="text-muted">
    Complete immutable trail tracing the decision chain: 
    <strong>Disruption (Sentinel) → Re-plan Proposal (Agent) → Approval (Human Producer)</strong>.
</p>

<div class="table-responsive shadow-sm rounded">
    <table class="table table-hover table-striped align-middle mb-0">
        <thead class="table-dark">
            <tr>
                <th>Timestamp (UTC)</th>
                <th>Event Type</th>
                <th>Actor / Identity</th>
                <th>Details & Narrative</th>
            </tr>
        </thead>
        <tbody>
            @if (events.Count == 0)
            {
                <tr>
                    <td colspan="4" class="text-center text-muted py-4">No audit events recorded yet.</td>
                </tr>
            }
            else
            {
                @foreach (var ev in events)
                {
                    <tr>
                        <td class="text-nowrap small text-secondary">@ev.Timestamp.ToString("yyyy-MM-dd HH:mm:ss")</td>
                        <td>
                            <span class="badge @GetBadgeClass(ev.EventType)">@ev.EventType</span>
                        </td>
                        <td><strong>@ev.Actor</strong></td>
                        <td>@Describe(ev)</td>
                    </tr>
                }
            }
        </tbody>
    </table>
</div>

@code {
    private List<AuditEvent> events = new();

    protected override async Task OnInitializedAsync()
    {
        // An audit trail that invents entries when it has none is worse than an empty one.
        // If nothing has happened yet, the page says so.
        events = await DbContext.AuditEvents
            .AsNoTracking()
            .OrderByDescending(e => e.Timestamp)
            .ToListAsync();
    }

    /// <summary>
    /// Replan proposals are stored as JSON so the proposals page can rebuild them after a
    /// reload. That is the right storage format and the wrong thing to show a producer, so
    /// it is rendered as prose here.
    /// </summary>
    private static string Describe(AuditEvent ev)
    {
        if (ev.EventType != "ReplanProposed")
        {
            return ev.Details;
        }

        try
        {
            using var doc = System.Text.Json.JsonDocument.Parse(ev.Details);
            var root = doc.RootElement;
            var title = root.TryGetProperty("Title", out var t) ? t.GetString() : null;
            var strategy = root.TryGetProperty("Strategy", out var s) ? s.GetString() : null;
            var why = root.TryGetProperty("Justification", out var j) ? j.GetString() : null;

            return title is null ? ev.Details : $"{title} ({strategy}). {why}";
        }
        catch (System.Text.Json.JsonException)
        {
            return ev.Details;
        }
    }

    private string GetBadgeClass(string eventType) => eventType switch
    {
        "DisruptionDetected" => "bg-danger",
        "ReplanProposed" or "ScheduleDrafted" => "bg-warning text-dark",
        "ScheduleCommitted" => "bg-success",
        "BreakdownImported" => "bg-info text-dark",
        _ => "bg-secondary"
    };
}
